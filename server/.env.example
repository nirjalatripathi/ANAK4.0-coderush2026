PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/rahat
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
ADMIN_EMAIL=admin@rahat.gov.np
ADMIN_PASSWORD=
ADMIN_NAME=RAHAT System Administrator
DEMO_OFFICIAL_PASSWORD=CampOfficial@2026
DEMO_CITIZEN_PASSWORD=CitizenDemo@2026

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy name still accepted:
# SUPABASE_SERVICE_ROLE_KEY=

# Khalti ePayment — server only. Never put these in client/.env or VITE_*.
# Sandbox secret comes from https://test-admin.khalti.com
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=your_khalti_live_secret_key
KHALTI_INITIATE_URL=https://dev.khalti.com/api/v2/epayment/initiate/
KHALTI_LOOKUP_URL=https://dev.khalti.com/api/v2/epayment/lookup/
KHALTI_SANDBOX_FALLBACK=true
